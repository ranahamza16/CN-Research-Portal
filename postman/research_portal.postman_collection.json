{
  "info": {
    "_postman_id": "c1f78e40-9a21-4f4e-a4b1-8b3d81b952f4",
    "name": "University Research Opportunity Portal API",
    "description": "Postman Collection for Computer Networks (CS3014) Assignment 1: University Research Opportunity Portal.\nIncludes full test suite demonstrating CRUD operations, status updates, 404 Not Found error handling, and 400 Bad Request validation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "createdId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "deleteTargetId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        },
        "description": "Checks whether the API server is up and running."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"API status is online\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql(\"online\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "1. Create Opportunity #1 (NLP & Sentiment Analysis)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Multilingual Sentiment Analysis for Low-Resource Languages\",\n  \"description\": \"Developing fine-tuned transformer models for sentiment classification on regional low-resource languages including Urdu and Pashto.\",\n  \"research_area\": \"Natural Language Processing\",\n  \"faculty_name\": \"Dr. Tariq Rahim\",\n  \"department\": \"Computer Science\",\n  \"required_skills\": \"Python, HuggingFace Transformers, PyTorch, Tokenizers\",\n  \"available_positions\": 2,\n  \"application_deadline\": \"2026-11-20\",\n  \"status\": \"Open\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/opportunities",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "opportunities"
          ]
        },
        "description": "Creates first research opportunity."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Response contains created opportunity object\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.data).to.have.property('id');",
              "    pm.collectionVariables.set(\"createdId\", jsonData.data.id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Create Opportunity #2 (SDN & Zero Trust Security)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Zero-Trust Architecture for Software-Defined Enterprise Networks\",\n  \"description\": \"Investigation into micro-segmentation and continuous authentication within OpenFlow-based enterprise networks.\",\n  \"research_area\": \"Computer Networks & Cyber Security\",\n  \"faculty_name\": \"Dr. Mohammad Faisal\",\n  \"department\": \"Computer Science\",\n  \"required_skills\": \"OpenFlow, Mininet, Python, Wireshark, Cryptography\",\n  \"available_positions\": 3,\n  \"application_deadline\": \"2026-12-01\",\n  \"status\": \"Open\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/opportunities",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "opportunities"
          ]
        },
        "description": "Creates second research opportunity."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Opportunity is Open and has valid fields\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data.status).to.eql('Open');",
              "    pm.expect(jsonData.data.available_positions).to.eql(3);",
              "});"
            ]
          }
        }
      ]
    },
