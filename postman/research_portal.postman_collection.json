        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Temporary Research Opening on Blockchain Consensus\",\n  \"description\": \"Evaluating latency and throughput tradeoffs of Raft vs PBFT in permissioned blockchain ledgers for academic credit transfers.\",\n  \"research_area\": \"Distributed Systems\",\n  \"faculty_name\": \"Dr. Umar Farooq\",\n  \"department\": \"Software Engineering\",\n  \"required_skills\": \"Go, Docker, Distributed Algorithms\",\n  \"available_positions\": 1,\n  \"application_deadline\": \"2026-10-31\",\n  \"status\": \"Open\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/opportunities",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "opportunities"
          ]
        },
        "description": "Creates third research opportunity, saved as deleteTargetId for later test cases."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.collectionVariables.set(\"deleteTargetId\", jsonData.data.id);"
            ]
          }
        }
      ]
    },
